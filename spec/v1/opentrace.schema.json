{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/vrajpatell/opentrace-ml/spec/v1/opentrace.schema.json",
  "title": "OpenTrace ML shared contracts v1",
  "type": "object",
  "$defs": {
    "bounding_box": {
      "type": "object",
      "additionalProperties": false,
      "required": ["xmin", "ymin", "xmax", "ymax"],
      "properties": {
        "xmin": {"type": "number"},
        "ymin": {"type": "number"},
        "xmax": {"type": "number"},
        "ymax": {"type": "number"}
      }
    },
    "detection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["label", "confidence", "bbox", "timestamp_seconds"],
      "properties": {
        "label": {"type": "string", "minLength": 1},
        "confidence": {"type": "number", "minimum": 0, "maximum": 1},
        "bbox": {"$ref": "#/$defs/bounding_box"},
        "timestamp_seconds": {"type": "number", "minimum": 0},
        "frame_id": {"type": ["string", "null"]}
      }
    },
    "geo_point": {
      "type": "object",
      "additionalProperties": false,
      "required": ["latitude", "longitude", "timestamp_seconds"],
      "properties": {
        "latitude": {"type": "number", "minimum": -90, "maximum": 90},
        "longitude": {"type": "number", "minimum": -180, "maximum": 180},
        "timestamp_seconds": {"type": "number", "minimum": 0}
      }
    },
    "route_signals": {
      "type": "object",
      "additionalProperties": false,
      "required": ["route_id", "distance_m", "shortest_distance_m", "potholes", "other_hazards", "traffic_ratio", "unmatched_ratio"],
      "properties": {
        "route_id": {"type": "string", "minLength": 1},
        "distance_m": {"type": "number", "exclusiveMinimum": 0},
        "shortest_distance_m": {"type": "number", "exclusiveMinimum": 0},
        "potholes": {"type": "integer", "minimum": 0},
        "other_hazards": {"type": "integer", "minimum": 0},
        "traffic_ratio": {"type": "number", "minimum": 0, "maximum": 1},
        "unmatched_ratio": {"type": "number", "minimum": 0, "maximum": 1}
      }
    }
  },
  "oneOf": [
    {"$ref": "#/$defs/bounding_box"},
    {"$ref": "#/$defs/detection"},
    {"$ref": "#/$defs/geo_point"},
    {"$ref": "#/$defs/route_signals"}
  ]
}
