{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/vrajpatell/opentrace-ml/spec/v1/ensemble-model.schema.json",
  "title": "OpenTrace fixed-offset horizon ensemble v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "last_timestamp",
    "frequency_seconds",
    "selected_models",
    "candidates"
  ],
  "properties": {
    "format": {
      "const": "opentrace.horizon-ensemble.v1"
    },
    "last_timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "frequency_seconds": {
      "type": "integer",
      "minimum": 1,
      "maximum": 31536000
    },
    "selected_models": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4096,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "candidates": {
      "type": "object",
      "minProperties": 1,
      "maxProperties": 64,
      "additionalProperties": {
        "oneOf": [
          {
            "$ref": "neural-model.schema.json"
          },
          {
            "$ref": "traffic-model.schema.json"
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "format",
              "season"
            ],
            "properties": {
              "format": {
                "const": "opentrace.seasonal.v1"
              },
              "season": {
                "type": "array",
                "minItems": 1,
                "maxItems": 4096,
                "items": {
                  "type": "number",
                  "minimum": 0
                }
              }
            }
          }
        ]
      }
    }
  }
}
