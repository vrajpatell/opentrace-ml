{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/vrajpatell/opentrace-ml/spec/v1/traffic-model.schema.json",
  "title": "OpenTrace portable linear traffic model v1",
  "description": "Data-only inference state. Vector lengths must also be validated in code: mean/scale/coefficients = 5 + lags, history = lags. NaN and infinity are forbidden.",
  "type": "object",
  "additionalProperties": false,
  "required": ["format", "feature_layout", "lags", "mean", "scale", "coefficients", "intercept", "history"],
  "properties": {
    "format": {"const": "opentrace.traffic-linear.v1"},
    "feature_layout": {"const": "wall_clock_calendar5_lags_oldest_first"},
    "lags": {"type": "integer", "minimum": 1, "maximum": 4096},
    "mean": {"$ref": "#/$defs/feature_vector"},
    "scale": {"type": "array", "minItems": 6, "maxItems": 4101, "items": {"type": "number", "exclusiveMinimum": 0}},
    "coefficients": {"$ref": "#/$defs/feature_vector"},
    "intercept": {"type": "number"},
    "history": {"type": "array", "minItems": 1, "maxItems": 4096, "items": {"type": "number", "minimum": 0}}
  },
  "$defs": {
    "feature_vector": {"type": "array", "minItems": 6, "maxItems": 4101, "items": {"type": "number"}}
  }
}
